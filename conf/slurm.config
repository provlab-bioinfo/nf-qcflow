/*
    Nextflow config: tuned for Genomics cluster
    Partitions:
        vm-cpu   → 64 GB nodes (general workloads)
        big-ram  → 162 GB node (medium memory jobs)
        huge-ram → 257 GB node (heavy memory, BAKTA full DB)

    Note: resource limits are set via the native `resourceLimits` directive.
    The old `check_max()` function was removed because Nextflow >= 26.04
    rejects top-level `def` functions in config files.
*/

/*
 * Default process settings
 */
process {
    executor = 'slurm'

    // Default queue (labels override this below)
    queue = 'vm-cpu'

    // Hard caps applied automatically to every task request
    resourceLimits = [
        memory: 240.GB,
        time:   240.h,
        cpus:   24
    ]

    clusterOptions = {
        "-o slurm_logs_${task.process}.%j.out " +
        "-e slurm_logs_${task.process}.%j.err"
    }

    // Default resources for unlabeled tasks
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Retry on OOM, signals, network failures
    errorStrategy = { task.exitStatus in ([1, 137, 143, 104] + (130..145)) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = -1

    //
    // LABELS
    //

    // Small jobs → vm-cpu (12 CPUs, ~64 GB)
    withLabel:process_single {
        queue  = 'vm-cpu'
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withLabel:process_low {
        queue  = 'vm-cpu'
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
        maxRetries = 2
    }

    // Medium jobs → big-ram (24 CPUs, 162 GB)
    withLabel:process_medium {
        queue  = 'big-ram'
        cpus   = 6
        memory = { 48.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    // High jobs → big-ram or huge-ram (24 CPUs)
    withLabel:process_high {
        queue  = 'big-ram,huge-ram'
        cpus   = 8
        memory = { 75.GB * task.attempt }
        time   = { 16.h * task.attempt }
        maxRetries = 3
    }

    // High memory jobs → huge-ram (24 CPUs, 257 GB)
    withLabel:process_high_memory {
        queue  = 'huge-ram'
        cpus   = 12
        memory = { 120.GB * task.attempt }
        time   = { 24.h * task.attempt }
        maxRetries = 2
    }

    // Special error handling labels
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

}
