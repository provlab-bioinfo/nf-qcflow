/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    // In your global configuration section:
    publishDir = [path: {
        // If the process defines ext.dir, use it. Otherwise, use the lowercase process name.
        task.ext.dir
            ? "${params.outdir}/${task.ext.dir}"
            : "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}"
    }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]


    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QC
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */
    withName: FASTP {

        //ext.args = ["--cut_front", "--cut_front_window_size=4", "--cut_front_mean_quality=20", "--cut_tail", "--cut_tail_window_size=4", "--cut_tail_mean_quality=20", "--n_base_limit=0", "--qualified_quality_phred=20", "--average_qual=20", "--length_required=75", "--detect_adapter_for_pe"].join(' ').trim()
        //match fluAB for easier comparison but will come back again
        ext.args = [
            "--cut_front",
            "--cut_front_window_size=1",
            "--cut_front_mean_quality=10",
            "--cut_tail",
            "--cut_tail_window_size=1",
            "--cut_tail_mean_quality=10",
            "--n_base_limit 0",
            "--qualified_quality_phred 20",
            "--average_qual 20",
            "--length_required 50",
            "--detect_adapter_for_pe"
        ].join(' ').trim()

    }
    withName: FASTPLONG {
        /*
1. What Happens with the 200 bp Cutoff (Fastplong)

• The Advantage (Safety Net for Rapid/Degraded Kits): If you happened to use a Rapid Barcoding kit (which fragments amplicons) or if your viral RNA was slightly degraded, keeping reads down to 200 bp ensures you do not lose critical fragment data. These shorter fragments can still be mapped back to a reference genome to build depth.
• The Disadvantage (Noisy Data): You will pull in a lot of primer-dimers, short non-specific PCR artifacts, and heavily aborted reads. If you are doing de novo assembly, these 200–500 bp reads can confuse the assembler, create loops in the assembly graph, or generate fragmented contigs.

2. What Happens with the 500 bp Cutoff (Porechop + Chopper)

• The Advantage (Cleaner Assembly): Dropping everything below 500 bp acts as an aggressive filter against PCR trash. It ensures that almost every read processed is a substantial piece of an influenza segment, which generally yields cleaner de novo assemblies and fewer false-positive variants during alignment.
• The Disadvantage (Potential Coverage Gaps): If the ends of your segments (near the universal primers) were heavily chopped due to dropping quality scores, some reads might fall into the 400 bp range. A 500 bp cutoff will throw them away, which could slightly reduce coverage at the extreme 3' and 5' ends of your viral segments.

Direct Comparison Matrix


Pipeline Strategy	Minimum Length	Impact on Influenza Data	Recommended Downstream Use
Porechop + Chopper	500 bp	Discards primer-dimers; highly robust; safe for all 8 complete segments (smallest is ~890 bp).	Ideal for De Novo Assembly (e.g., Flye, Canu) to get clean, full-length segments.
Fastplong	200 bp	Retains short fragments; maximizes raw read count; risks adding artifact noise.	Ideal for Reference-Guided Mapping (e.g., Minimap2) where short reads can safely map to a known skeleton.


Moving Forward: How to Align Them

To truly compare Porechop vs. Fastplong rather than comparing two different length thresholds, you should normalize your parameters.
If you want to see which tool handles adapters and overall cleaning better, re-run your Fastplong command with --length_required 500 (or push your Chopper min-length down to 200) so they match perfectly. For whole-segment influenza data, 500 bp is generally considered the safer scientific standard to prevent artifact inflation unless you explicitly used a transposase-based Rapid kit.
Now that you have run both pipelines, let me know:
• Did you notice a significant difference in the final sequence depth (coverage) or genome completeness between the two?
• Are you seeing any differences in execution time on your machine?
the old version is using 500bp, we are goign to use 500 for now
    */
        //ext.args = ["--cut_front", "--cut_front_window_size=50", "--cut_front_mean_quality=10", "--cut_tail", "--cut_tail_window_size=50", "--cut_tail_mean_quality=10", "--n_base_limit=0", "--qualified_quality_phred=10", "--mean_qual=10", "--length_required=500"].join(' ').trim()
        // Swapping window sizes from 50 down to 20 to avoid over-aggressive read destruction
        ext.args = ["--cut_front", "--cut_front_window_size=20", "--cut_front_mean_quality=10", "--cut_tail", "--cut_tail_window_size=20", "--cut_tail_mean_quality=10", "--qualified_quality_phred=10", "--mean_qual=10", "--length_required=200"].join(' ').trim()

        ext.dir = 'readqc'
    }
    withName: DEACON_FILTER {
        ext.prefix = { "${meta.id}.deacon" }
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_INPUT {
        ext.prefix = { "${meta.id}.input_seqstats" }
        ext.args = '-b -T'
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_DEHOSTED {
        ext.prefix = { "${meta.id}.dehost_seqstats" }
        ext.args = '-b -T '
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_TRIMMED {
        ext.prefix = { "${meta.id}.trimmed_seqstats" }
        ext.args = '-b -T'
        ext.dir = 'readqc'
    }
    withName: CSVTK_CONCAT_INPUT_STATS {
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_SUMMARY_INPUT {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.input" }
    }
    withName: CSVTK_CONCAT_TRIMMED_STATS {
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_SUMMARY_TRIMMED {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.trimmed" }
    }
    withName: CSVTK_CONCAT_DEHOSTED_STATS {
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_SUMMARY_DEHOSTED {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.dehosted" }
    }


}
