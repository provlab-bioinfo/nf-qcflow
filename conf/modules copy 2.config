/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */
process {

    /* publishDir = [
    path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    mode: params.publish_dir_mode,
    saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ] */
    publishDir = [path: {
        // If the process defines ext.dir, use it. Otherwise, use the lowercase process name.
        task.ext.dir
            ? "${params.outdir}/${task.ext.dir}"
            : "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}"
    }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]

    withName: FASTQC_INPUT {
        //ext.prefix = { "${meta.id}-illumina_input" }
        ext.args = '--quiet'
        ext.dir = 'fastqc/input'
    }
    withName: FASTQC_TRIMMED_WITH_BBDUK {
        ext.prefix = { "${meta.id}.bbduk_trimmed" }
        ext.args = '--quiet'
        ext.dir = 'fastqc/trimmed'
    }
    withName: FASTQC_TRIMMED_WITH_FASTP {
        ext.prefix = { "${meta.id}.fastp_trimmed" }
        ext.args = '--quiet'
        ext.dir = 'fastqc/trimmed'
    }

    withName: FASTQC_DEHOST {
        ext.prefix = { "${meta.id}.dehosted" }
        ext.args = '--quiet'
        ext.dir = 'fastqc/dehost'
    }
    withName: SEQKIT_STATS_INPUT {
        ext.prefix = { "${meta.id}.seqstats_input" }
        ext.args = '-b -T'
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_TRIMMED {
        ext.prefix = { "${meta.id}.seqstats_trimmed" }
        ext.args = '-b -T'
        ext.dir = 'readqc'
    }
    withName: SEQKIT_STATS_DEHOSTED {
        ext.prefix = { "${meta.id}.seqstats_dehosted" }
        ext.args = '-b -T'
        ext.dir = 'readqc'
    }
    withName: HOSTILE_CLEAN_ILLUMINA {
        ext.args = '--force --aligner bowtie2'
        ext.dir = 'readqc'
    }
    withName: CSVTK_CONCAT_STATS_INPUT {
        ext.dir = 'readqc'
    }
    withName: CSVTK_CONCAT_STATS_TRIMMED {
        ext.dir = 'readqc'
    }
    withName: CSVTK_CONCAT_STATS_DEHOSTED {
        ext.dir = 'readqc'
    }
    withName: KRAKEN2_KRAKEN2 {
        ext.prefix = { "${meta.id}-illumina" }
        ext.dir = 'taxon'
    }
    withName: BRACKEN_BRACKEN {
        ext.prefix = { "${meta.id}-illumina" }
        ext.dir = 'taxon'
    }
    withName: BRACKEN_GETTOPMATCHES {
        ext.prefix = { "${meta.id}.topmatches" }
        ext.dir = 'taxon'
    }

    withName: BBMAP_BBDUK {
        ext.prefix = { "${meta.id}-illumina" }
        ext.args = ["ref=adapters,artifacts,phix", "ktrim=r", "k=23", "mink=11", "hdist=1", "tpe", "tbo", "maq=15", "trimq=10", "qtrim=r", "minavgquality=20", "minlength=50"].join(' ').trim()
        ext.dir = 'readqc'
    }
    withName: FASTP {
        ext.prefix = { "${meta.id}-illumina" }
        ext.args = [
            "--cut_front",
            "--cut_front_window_size=1",
            "--cut_front_mean_quality=10",
            "--cut_tail",
            "--cut_tail_window_size=1",
            "--cut_tail_mean_quality=10",
            "--n_base_limit 0",
            "--qualified_quality_phred 20",
            "--average_qual 20",
            "--length_required 50",
            "--detect_adapter_for_pe",
        ].join(' ').trim()
        ext.dir = 'readqc'
    }
    /*
    withName: '.*:QC_ILLUMINA:REPORT_QCSUMMARY' {
    ext.prefix = { "${meta.id}-illumina" }
    ext.dir = 'readqc'
    }
    withName: '.*:QC_NANOPORE:REPORT_QCSUMMARY' {
    ext.prefix = { "${meta.id}-nanopore" }
    ext.dir = 'readqc'
    }

    withName: '.*:QC_(ILLUMINA|NANOPORE):HTML_COPYDIR' {
    ext.dir = 'html_report'
    }
    withName: '.*:QC_ILLUMINA:HTML_DATATABLE_CSV2JSON_QCREPORT' {
    ext.prefix = { "reads.qc_report"}
    ext.args = "--sep ,"
    ext.dir = 'html_report/illumina/data'
    }

    withName: '.*:QC_NANOPORE:HTML_DATATABLE_CSV2JSON_QCREPORT' {
    ext.prefix = { "reads.qc_report" }
    ext.args = "--sep ,"
    ext.dir = 'html_report/nanopore/data'
    }
    withName: '.*:QC_ILLUMINA:HTML_DATATABLE_CSV2JSON_TOPMATCHES'{
    ext.prefix = { "reads.topmatches"}
    ext.args = "--sep , --name topmatch_data --colname topmatch_tablecol"
    ext.dir = 'html_report/illumina/data'
    }
    withName: '.*:QC_NANOPORE:HTML_DATATABLE_CSV2JSON_TOPMATCHES' {
    ext.prefix = { "reads.topmatches" }
    ext.args = "--sep , --name topmatch_data --colname topmatch_tablecol"
    ext.dir = 'html_report/nanopore/data'
    } */




    withName: NANOPLOT_INPUT {
        //ext.prefix = { "${meta.id}" }
        ext.args = "-c darkblue --tsv_stats --info_in_report --plots hex dot"
        ext.dir = { "nanoplot/input/${meta.id}" }
    }
    withName: NANOPLOT_QC {
        //ext.prefix = { "${meta.id}-nanopore_qc" }
        ext.args = "-c darkblue --tsv_stats --info_in_report --plots hex dot"
        ext.dir = { "nanoplot/qc/${meta.id}" }
    }
    withName: NANOPLOT_DEHOST {
        //ext.prefix = { "${meta.id}-nanopore_dehost" }
        ext.args = "-c darkblue --tsv_stats --info_in_report --plots hex dot"
        ext.dir = { "nanoplot/dehost/${meta.id}" }
    }
    withName: PORECHOP_PORECHOP {
        ext.prefix = { "${meta.id}-nanopore.porechop" }
        ext.dir = 'readqc'
    }

    withName: CHOPPER {
        ext.args2 = "-q 10 --minlength 200"
        ext.prefix = { "${meta.id}-nanopore.chopper" }
        ext.dir = 'readqc'
    }

    //dehost
    withName: HOSTILE_CLEAN_NANOPORE {
        ext.args = "--force --aligner-args '-ax map-ont'"
        ext.prefix = { "${meta.id}-nanopore.dehost" }
        publishDir = [
            [
                path: { "${params.outdir}/readqc" },
                mode: params.publish_dir_mode,
                pattern: '*/*',
                saveAs: { filename ->
                    filename == 'versions.yml' ? null : filename.replaceFirst(/^cleaned_reads\//, '')
                },
                enable: true,
            ],
            [
                path: { "${params.outdir}/readqc" },
                mode: params.publish_dir_mode,
                pattern: '*.dehost.json',
                enable: true,
            ],
            /*  [
            path: { "${params.outdir}/qc_reads" },
            mode: params.publish_dir_mode,
            pattern: "cleaned_reads/*",
            enable: true,
            saveAs: { filename ->
            filename == 'versions.yml' ? null : filename.replaceFirst(/^cleaned_reads\//, '')
            },
            ], */
        ]
    }
    withName: FASTPLONG {
        ext.prefix = { "${meta.id}-nanopore" }
        ext.args = "--mean_qual 10 -l 200"
        ext.dir = 'readqc'
    }

    withName: CSVTK_CONCAT {
        ext.dir = 'report'
    }

    withName: 'PUBLISH_(LONG|SHORT)READS' {
        ext.dir = 'qcreads'
    }

    withName: PUBLISH_SAMPLESHEET {
        ext.prefix = { "qc_" }
        ext.dir = "."
    }

    withName: DEACON_FILTER {
        //ext.prefix = { "${meta.id}.deacon" }

        ext.dir = 'readqc'
    }
     withName: READ_QC_REPORT {
        //ext.dir = 'report'
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: params.publish_dir_mode,
            ],
            [
                path: { "${params.outdir}/readqc" },
                mode: params.publish_dir_mode,
            ],
        ]
    }
    withName: SEQKIT_STATS_SUMMARY_INPUT {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.input" }
    }
    withName: SEQKIT_STATS_SUMMARY_TRIMMED {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.trimmed" }
    }
    withName: SEQKIT_STATS_SUMMARY_DEHOSTED {
        ext.dir = 'readqc'
        ext.prefix = { "seqstats.dehosted" }
    }

}
